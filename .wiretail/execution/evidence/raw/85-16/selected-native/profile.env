# GPU-hot / host-cold hybrid fast profile.
#
# The Buun runtime keeps the live and speculative draft KV caches in fixed
# Turbo4 on the GPU.  Its
# prompt-cache and context-checkpoint machinery retain inactive/warm state in
# host RAM, while explicit slot checkpoints are written to the NVMe-backed
# session directory.  This is intentionally not --no-kv-offload: live decode
# must never fall back to CPU q8 KV.
PROFILE_ID=qwen38-fast
MODEL=/srv/ai/models/text/current.gguf
SERVER_BIN=/srv/ai/paged-kv/build/buun/bin/llama-server
ALIAS=qwen38-fast-turbo4-mtp
# Stable long-context ceiling with enough VRAM headroom for transient
# attention/dequantization scratch allocations during real long prompts.
CTX=77824
BATCH=128
UBATCH=64
PARALLEL=1
CACHE_TYPE_K=turbo4
CACHE_TYPE_V=turbo4
N_GPU_LAYERS=999
FLASH_ATTN=on
FIT=off
POLL=0
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_TYPE_K=turbo4
SPEC_DRAFT_TYPE_V=turbo4
TIERED_CACHE=1
CACHE_RAM_MIB=12288
CACHE_IDLE_SLOTS=1
KV_UNIFIED=1
CTX_CHECKPOINTS=8
CHECKPOINT_MIN_STEP=8192
SLOT_SAVE_PATH=/srv/ai/paged-kv/data/sessions/hybrid-fast
